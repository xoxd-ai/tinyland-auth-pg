load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@tummycrypt_tinyland_auth_pg_npm//:defs.bzl", "npm_link_all_packages")
load("@tummycrypt_tinyland_auth_pg_npm//:vitest/package_json.bzl", vitest_bin = "bin")

package(default_visibility = ["//visibility:public"])

npm_link_all_packages(name = "node_modules")

ts_project(
    name = "tinyland-auth-pg",
    srcs = glob(["src/**/*.ts"], exclude = ["src/__tests__/**"]),
    declaration = True,
    declaration_map = True,
    out_dir = "dist",
    root_dir = "src",
    source_map = False,
    transpiler = "tsc",
    tsconfig = "tsconfig.json",
    validate = False,
    deps = [
        ":node_modules",
        ":node_modules/@neondatabase/serverless",
        ":node_modules/@tummycrypt/tinyland-auth",
        ":node_modules/@types/node",
        ":node_modules/@types/pg",
        ":node_modules/drizzle-orm",
        ":node_modules/pg",
    ],
)

vitest_bin.vitest_test(
    name = "test",
    args = ["run"],
    data = glob([
        "drizzle/**",
        "drizzle-public/**",
        "src/**/*.ts",
    ]) + [
        ":node_modules",
        # package-authority.test.ts reads the three version authorities.
        "BUILD.bazel",
        "MODULE.bazel",
        "package.json",
        "tsconfig.json",
        "vitest.config.ts",
    ],
    log_level = "info",
)

npm_package(
    name = "pkg",
    srcs = glob([
        "drizzle/**",
        "drizzle-public/**",
    ]) + [
        ":tinyland-auth-pg",
        "CHANGELOG.md",
        "README.md",
        "package.json",
    ],
    package = "@tummycrypt/tinyland-auth-pg",
    version = "0.3.0",
)
